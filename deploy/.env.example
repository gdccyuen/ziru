# Ziru local/deployment environment template (committed).
# Copy to .env and fill in your values; the real .env is gitignored.
# Ports: admin console 81, webui 80, API 5005 (configurable).

# --- Access ports ---
ADMIN_PUBLIC_URL=http://localhost:81
ADMIN_HOST_BIND=127.0.0.1
ADMIN_HOST_PORT=81
WEBUI_PUBLIC_URL=http://localhost:80
WEBUI_HOST_BIND=127.0.0.1
WEBUI_HOST_PORT=80
API_HOST_PORT=5005

# --- Database / Redis ---
DATABASE_URL=postgresql+asyncpg://ziru:CHANGE_ME@127.0.0.1:5432/ziru
DB_SSL_MODE=disable
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_REDIS_URL=redis://127.0.0.1:6379/0

# --- Storage (local filesystem for self-hosted demo; s3/minio for production) ---
S3_TYPE=filesystem
S3_BUCKET_NAME=ziru-uploads
S3_RESULTS_BUCKET=ziru-results
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_TEMP_PATH=/tmp/ziru
TMP_PATH=/tmp/ziru
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/ziru/storage
USERS_DATA_PATH=/var/lib/ziru/users
SELF_HOSTED_INIT_POSTGRES_EXTENSIONS=true
SELF_HOSTED_CREATE_STORAGE_BUCKETS=false
S3_USE_SSL=false
S3_ADDRESSING_STYLE=path
S3_REGION=us-west-1
S3_WEBHOOK_AUTH_TOKEN=CHANGE_ME

# --- Runtime ---
ENVIRONMENT=production
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_LOGIN_ENABLED=true
RATE_LIMIT_ENABLED=true
MAX_CONCURRENT_JOBS=4

# --- Bootstrap admin (first boot when users table is empty; force password change) ---
ADMIN_BOOTSTRAP_EMAIL=admin@ziru.local
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME

# --- LLM (optional; leave empty for evidence-only mode) ---
# Any OpenAI-compatible endpoint: local vLLM/Ollama/llama.cpp or a cloud provider.
# Keyless local servers: use any non-empty dummy PROVIDER_KEY (header is tolerated);
# cloud providers: put the real API key here.
PROVIDER_URL=http://127.0.0.1:61265/v1
PROVIDER_KEY=local-keyless
# Per-role model names (server may ignore them - it serves its loaded model):
NORMAL_MODEL=unsloth/Qwen3.8-27B-GGUF
HIERARCHY_LLM_MODEL=unsloth/Qwen3.8-27B-GGUF
RETRIEVAL_PLANNER_MODEL=unsloth/Qwen3.8-27B-GGUF
IMAGE_MODEL=unsloth/Qwen3.8-27B-GGUF
IMAGE_MODEL_MAX=unsloth/Qwen3.8-27B-GGUF

# --- Chat answer synthesis (optional) ---
# When true, the chat runs one extra LLM call to organize evidence into a readable answer.
CHAT_ANSWER_SYNTHESIS=false
